                <mxCell id="p0" value="&lt;b&gt;1.0&lt;/b&gt;&lt;br&gt;Получение согласия&lt;br&gt;на обработку ПДн&lt;br&gt;&lt;i&gt;(Администратор)&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
