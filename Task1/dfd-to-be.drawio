                </mxCell>
                <mxCell id="3SeQJ83ZRHWHh2yqmhwc-1" value="ЛЕГЕНДА TO-BE:&lt;br&gt;Зелёные стрелки - защищённые потоки&lt;br&gt;Пунктир - аудит-логи&lt;br&gt;[TAG] - теги конфиденциальности&lt;br&gt;(AES-256) - шифрование при хранении&lt;br&gt;(TLS 1.3) - шифрование при передаче" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
                    <mxGeometry x="530" y="840" width="330" height="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
