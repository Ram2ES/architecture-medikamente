                    <mxGeometry x="10" y="30" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p1" value="&lt;b&gt;2.1&lt;/b&gt;&lt;br&gt;Просмотр своего&lt;br&gt;журнала записей&lt;br&gt;&lt;i&gt;(RBAC: только свой)&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="330" y="80" width="240" height="110" as="geometry"/>
