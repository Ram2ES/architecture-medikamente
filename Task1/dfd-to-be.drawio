                </mxCell>
                <mxCell id="f0b" value="Согласие (подпись)" style="endArrow=classic;html=1;strokeColor=#009900;fontSize=9;fontColor=#009900;edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="p0" target="ds0" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f1" value="[PII] ФИО, телефон, email (TLS 1.3, RBAC: ресепшен)" style="endArrow=classic;html=1;strokeColor=#009900;fontSize=9;fontColor=#009900;edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="p0" target="p1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f2" value="[PII] Данные пациента (AES-256, ID вместо ФИО)" style="endArrow=classic;html=1;strokeColor=#009900;fontSize=9;fontColor=#009900;edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="p1" target="ds1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f3" value="[PII] Тегирование: [HIGH][PII][ENCRYPT][AUDIT]" style="endArrow=classic;html=1;strokeColor=#009900;fontSize=9;fontColor=#009900;rounded=1;" parent="1" source="p1" target="p2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f4" value="Документы (AES-256, ID пациента)" style="endArrow=classic;html=1;strokeColor=#009900;fontSize=9;fontColor=#009900;edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="p2" target="ds2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f5" value="ID пациента + специалист + дата" style="endArrow=classic;html=1;strokeColor=#009900;fontSize=9;fontColor=#009900;edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="p3" target="ds3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f_audit" value="Логи всех операций" style="endArrow=classic;html=1;strokeColor=#999999;fontSize=8;fontColor=#666666;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="p2" target="audit" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sec_note" value="МЕРЫ БЕЗОПАСНОСТИ (TO-BE):&lt;br&gt;+ Согласие на обработку ПДн перед регистрацией&lt;br&gt;+ Шифрование: AES-256 (at rest), TLS 1.3 (in transit)&lt;br&gt;+ Идентификатор пациента вместо ФИО в именах файлов&lt;br&gt;+ Тегирование данных через Apache NiFi + Atlas&lt;br&gt;+ RBAC: только роль «ресепшен» может регистрировать&lt;br&gt;+ Аудит всех операций в ELK Stack&lt;br&gt;+ Data Minimization: собирать только необходимые данные" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="30" y="790" width="450" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="ЛЕГЕНДА TO-BE:&lt;br&gt;Зелёные стрелки - защищённые потоки&lt;br&gt;Пунктир - аудит-логи&lt;br&gt;[TAG] - теги конфиденциальности&lt;br&gt;(AES-256) - шифрование при хранении&lt;br&gt;(TLS 1.3) - шифрование при передаче" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="530" y="790" width="330" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="V85HBUbC3z9guIOhFZVW-2" value="Выбор специалиста, дата/время" style="endArrow=classic;html=1;strokeColor=#828282;fontSize=9;fontColor=#404040;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.21;exitY=0.984;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="ee1" target="p3" edge="1">
                    <mxGeometry relative="1" as="geometry">
