                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sec_note" value="МЕРЫ БЕЗОПАСНОСТИ (TO-BE):&lt;br&gt;+ TLS 1.3 вместо нешифрованного TCP/IP для ККМ&lt;br&gt;+ Ликвидация двойного учёта: NiFi автоматизирует передачу&lt;br&gt;+ ID пациента вместо ФИО в платёжных записях&lt;br&gt;+ 1С в серверном режиме с RBAC и аудитом&lt;br&gt;+ RBAC: кассир, бухгалтер - раздельные роли&lt;br&gt;+ Аудит всех финансовых операций" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
