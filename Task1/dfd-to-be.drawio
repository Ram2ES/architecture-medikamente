                <mxCell id="f2" value="[FIN] Сумма, ID пациента, услуга (без ФИО)" style="endArrow=classic;html=1;strokeColor=#009900;fontSize=9;fontColor=#009900;rounded=1;" parent="1" source="p1" target="p2" edge="1">
