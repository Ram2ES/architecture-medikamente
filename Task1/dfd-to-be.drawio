                <mxCell id="f3" value="[PII] ID пациента (расшифровка по RBAC)" style="endArrow=classic;html=1;strokeColor=#009900;fontSize=9;fontColor=#009900;rounded=1;" parent="1" source="p1" target="p2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f4" value="[PHI] Мед.карта (AES-256, расшифровка по RBAC)" style="endArrow=classic;html=1;strokeColor=#009900;fontSize=9;fontColor=#009900;edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="ds2" target="p2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f5" value="Жалобы, симптомы" style="endArrow=classic;html=1;strokeColor=#828282;fontSize=9;fontColor=#404040;edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="ee1" target="p2" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="290" y="200"/>
                            <mxPoint x="290" y="320"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="f6" value="[PHI] Диагноз, назначения" style="endArrow=classic;html=1;strokeColor=#009900;fontSize=9;fontColor=#009900;rounded=1;" parent="1" source="p2" target="p3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f7" value="[PHI] Заключение (AES-256, теги [CRITICAL][PHI][AUDIT])" style="endArrow=classic;html=1;strokeColor=#009900;fontSize=9;fontColor=#009900;edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="p3" target="ds2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f_audit" value="Логи доступа к PHI" style="endArrow=classic;html=1;strokeColor=#999999;fontSize=8;fontColor=#666666;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="p2" target="audit" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="280" y="350"/>
                            <mxPoint x="280" y="395"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="sec_note" value="МЕРЫ БЕЗОПАСНОСТИ (TO-BE):&lt;br&gt;+ RBAC: врач видит только свой журнал и своих пациентов&lt;br&gt;+ Шифрование мед.карт: AES-256 (at rest), TLS 1.3 (in transit)&lt;br&gt;+ Тегирование: [CRITICAL][PHI][AUDIT] на всех мед.данных&lt;br&gt;+ Обязательный аудит каждого доступа к PHI&lt;br&gt;+ Маскирование ФИО при отображении в журнале&lt;br&gt;+ Watermark при просмотре документов пациента&lt;br&gt;+ Алерт при нетипичном доступе (аномалия)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="30" y="680" width="450" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="0_vMl938ras7RYl3OWGw-1" value="ЛЕГЕНДА TO-BE:&lt;br&gt;Зелёные стрелки - защищённые потоки&lt;br&gt;Пунктир - аудит-логи&lt;br&gt;[TAG] - теги конфиденциальности&lt;br&gt;(AES-256) - шифрование при хранении&lt;br&gt;(TLS 1.3) - шифрование при передаче" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
                    <mxGeometry x="510" y="680" width="330" height="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
