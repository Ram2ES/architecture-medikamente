                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f2" value="[PII] Записи только своих пациентов (маскирование)" style="endArrow=classic;html=1;strokeColor=#009900;fontSize=9;fontColor=#009900;edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="ds1" target="p1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
